{
  "expo": {
    "name": "Faith Companion",
    "slug": "faith-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "faithcompanion",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F2EC",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F2EC"
    },
    "ios": {
      "bundleIdentifier": "com.isabellholdings.faithcompanion",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.isabellholdings.faithcompanion",
      "adaptiveIcon": {
        "backgroundColor": "#E2EDD8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Faith Companion",
      "shortName": "Companion",
      "themeColor": "#F5F2EC",
      "backgroundColor": "#F5F2EC"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F5F2EC"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#1F2430"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
